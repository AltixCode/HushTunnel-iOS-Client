# iOS Screenshots
# App Store requirements, as of 2026:
# - iPhone 6.9" Display (1320 x 2868)  -- mandatory for a new submission
# - iPad 13"  Display (2064 x 2752)
# Device names must match simulators that actually exist, or snapshot aborts
# with "device not found" and produces nothing. Xcode 27 ships neither
# "iPhone 12 Pro Max" nor "iPad Pro 13-inch (M4)", which is why the 13" iPad
# set was never populated. Check with: xcrun simctl list devices available
# Naming a device that EXISTS is not enough -- it has to BOOT. Five simulators
# on this machine, including the two named here before, carry `isDeleted => true`
# in their own device.plist while `simctl list devices available` still lists
# them as Shutdown. Booting one returns SimError 404 "Unable to boot deleted
# device", and snapshot does not stop: it prints "Device boot failed" in the
# first twenty lines, builds the whole app and test bundle for several minutes,
# then dies in a Ruby backtrace having produced nothing. Check a device with
# `xcrun simctl boot <udid>` and confirm it reaches Booted before trusting it.
#
# These two are verified bootable and produce the two sizes the App Store
# requires: 1320x2868 (6.9") and 2064x2752 (iPad 13").
devices([
  "AltixCode 6.9",
  "QA iPad 13"
])

languages([
  "en-US",
  "zh-Hans"
])

# reinstall_app(true) uninstalls first, and uninstall needs the bundle id.
# Without this, snapshot prompts for it and dies non-interactively with
# "Could not retrieve response as fastlane runs in non-interactive mode".
app_identifier("com.hushtunnel.ios")

project("./HushTunnel.xcodeproj")
scheme("SFI")
output_directory("./screenshots/ios")
clear_previous_screenshots(true)
reinstall_app(true)
skip_helper_version_check(true)
override_status_bar(true)
dark_mode(true)
number_of_retries(0)
stop_after_first_error(true)
skip_package_dependencies_resolution(true)
disable_package_automatic_updates(true)
cloned_source_packages_path("/tmp/fastlane_source_packages")
derived_data_path("/tmp/fastlane_derived_data")
localize_simulator(true)
